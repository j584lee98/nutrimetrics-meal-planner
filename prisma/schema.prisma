generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  passwordHash      String?
  name              String                 @default("")
  emailVerified     Boolean                @default(false)
  image             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  sessions          Session[]
  accounts          Account[]
  mealPlans         MealPlan[]
  customFoods       Food[]
  nutrientOverrides FoodNutrientOverride[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Food {
  id                String                 @id @default(cuid())
  name              String
  fdcId             Int?                   @unique
  ownerId           String?
  nutrientBasis     String                 @default("g")
  portionsJson      String                 @default("[]")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  owner             User?                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nutrients         FoodNutrient[]
  nutrientOverrides FoodNutrientOverride[]
  mealEntries       MealEntry[]

  @@index([ownerId])
}

model Nutrient {
  id        Int                    @id
  name      String
  unit      String
  foods     FoodNutrient[]
  overrides FoodNutrientOverride[]
}

model FoodNutrient {
  foodId     String
  nutrientId Int
  per100Unit Float    @map("per100g")
  derivation String?
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Restrict)

  @@id([foodId, nutrientId])
}

model FoodNutrientOverride {
  userId     String
  foodId     String
  nutrientId Int
  per100Unit Float    @map("per100g")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  food       Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id], onDelete: Restrict)

  @@id([userId, foodId, nutrientId])
}

model MealPlan {
  id        String   @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals     Meal[]

  @@index([userId])
  @@unique([id, userId])
}

model Meal {
  id         String      @id @default(cuid())
  name       String
  nameKey    String
  userId     String
  mealPlanId String
  mealPlan   MealPlan    @relation(fields: [mealPlanId, userId], references: [id, userId], onDelete: Cascade)
  entries    MealEntry[]

  @@index([mealPlanId])
  @@unique([userId, nameKey])
}

model MealEntry {
  id           String @id @default(cuid())
  mealId       String
  foodId       String
  quantity     Float
  unitLabel    String @default("g")
  basisPerUnit Float  @default(1)
  basis        String @default("g")
  position     Int    @default(0)
  meal         Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food         Food   @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@index([mealId])
  @@index([foodId])
}
